# GhostScrib Environment Configuration
# Copy this file to .env and adjust as needed.

# URL of the local Lukkinen AI Text Detector service
GHOSTSCRIB_DETECTOR_URL=http://127.0.0.1:8790

# Device for attribution scoring (cpu by default to avoid GPU VRAM contention with Lukkinen)
GHOSTSCRIB_DEVICE=cpu

# Contact email for polite API identification to Crossref and OpenAlex APIs
GHOSTSCRIB_CONTACT_EMAIL=researcher@example.org

# Request timeout in seconds for external citation APIs
GHOSTSCRIB_CITATION_TIMEOUT=10

# Request timeout in seconds for the Lukkinen detector service
GHOSTSCRIB_DETECTOR_TIMEOUT=60

# Optional API keys for generating reference texts (scripts/generate_reference_texts.py)
# Only needed if you want to generate new synthetic reference texts for model attribution
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

